telemetry.enable = false

listeners.tcp.default.bind = "0.0.0.0:1883"
listeners.ssl.default.enable = false
listeners.ws.default.enable = false
listeners.wss.default.enable = false

mqtt.client_attrs_init = [
  {
    expression = "nth(1, tokens(username, '/'))"
    set_as_attr = tenant
  },
  {
    # Initializers cannot depend on attributes created by another initializer.
    expression = "getenv(concat([nth(1, tokens(username, '/')), '_auth_token']))"
    set_as_attr = auth_token
  }
]

# Disable caches so each test exercises the HTTP service and policy changes.
authentication_settings.node_cache.enable = false
authentication = [
  {
    mechanism = password_based
    backend = http
    method = post
    url = "https://${client_attrs.tenant}.auth.example.com/authn"
    hostname_resolution = dynamic
    allowed_hosts = ["north.auth.example.com", "south.auth.example.com"]
    headers {
      "Content-Type" = "application/json"
      "X-API-Key" = "${client_attrs.auth_token}"
    }
    body {
      username = "${username}"
      password = "${password}"
      clientid = "${clientid}"
    }
    ssl {
      enable = true
      verify = verify_peer
      cacertfile = "/opt/emqx/etc/auth-ca/auth-ca.pem"
    }
  }
]

authorization {
  no_match = deny
  # Keep the connection open so MQTT 5 PUBACK/SUBACK expose the denied operation.
  deny_action = ignore
  cache.enable = false
  node_cache.enable = false
  sources = [
    {
      type = http
      method = post
      url = "https://${client_attrs.tenant}.auth.example.com/authz"
      hostname_resolution = dynamic
      allowed_hosts = ["north.auth.example.com", "south.auth.example.com"]
      headers {
        "Content-Type" = "application/json"
        "X-API-Key" = "${client_attrs.auth_token}"
      }
      body {
        username = "${username}"
        clientid = "${clientid}"
        action = "${action}"
        topic = "${topic}"
      }
      ssl {
        enable = true
        verify = verify_peer
        cacertfile = "/opt/emqx/etc/auth-ca/auth-ca.pem"
      }
    }
  ]
}
